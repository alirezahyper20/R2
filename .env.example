# Copy to .env and fill in.  cp .env.example .env

# Long random string — encrypts your saved Al-Waseet password. Keep it secret and never change it after setup.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

PORT=3000
TZ=Asia/Baghdad

# Set to 1 when the site is served over HTTPS (recommended in production)
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy (Caddy / Nginx) so login throttling sees real IPs
TRUST_PROXY=0

# Your domain, used only by the optional Caddy HTTPS service in docker-compose.yml
DOMAIN=store.example.com

# Optional: put the Al-Waseet login here instead of in the Settings page.
# Use the MERCHANT account (not a merchant-user account) — invoice APIs require it.
ALWASEET_USERNAME=
ALWASEET_PASSWORD=

# Leave as is. Change only to point at the mock server for testing.
ALWASEET_BASE_URL=https://api.alwaseet-iq.net/v1/merchant
